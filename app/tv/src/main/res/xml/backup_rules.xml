<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude databases containing auth tokens and server credentials -->
    <exclude
        domain="database"
        path="servers" />
    <exclude
        domain="database"
        path="servers-wal" />
    <exclude
        domain="database"
        path="servers-shm" />
    <!-- Exclude shared preferences with sensitive data -->
    <exclude
        domain="sharedpref"
        path="." />
    <!-- CE (#731): downloads and login caches are of no use without the servers database -->
    <exclude
        domain="external"
        path="downloads" />
    <exclude
        domain="file"
        path="images" />
    <exclude
        domain="file"
        path="trickplay" />
    <exclude
        domain="file"
        path="home-cache" />
</full-backup-content>
